# TRIVË — variáveis de ambiente
# Copie para .env.local (dev) e cadastre no dashboard da Vercel (Production/Preview).
# NUNCA commitar .env.local. Valores de exemplo abaixo são placeholders.

# --- Banco (Supabase Postgres, SEMPRE via pooler Supavisor porta 6543, transaction mode) ---
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Endereço público do site (SEM barra final) ---
# Base de todo link absoluto que SAI do sistema: e-mail de acesso/recuperação
# (/admin/acesso), retorno do Mercado Pago, links do WhatsApp, sitemap/robots e
# o serveOrigin do Inngest. Sem esta variável o código cai no domínio de
# produção — em Preview isso faz o link do e-mail apontar para a loja real.
NEXT_PUBLIC_SITE_URL=https://trivemaison.com.br

# --- Supabase (Auth/Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Somente servidor — vazamento em código client é bloqueado por check no CI.
# Além do acesso total ao banco, é ela que autentica o adapter de identidade
# (src/adapters/identity/supabase.ts): criar usuário do painel, gerar link de
# convite/recuperação, definir senha e bloquear acesso. Sem ela, /admin/usuarios
# e a recuperação de senha param de funcionar. Trate como senha máxima.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Mercado Pago (Fase 3; usar credenciais de TESTE em dev/preview) ---
MP_ACCESS_TOKEN=TEST-...
MP_WEBHOOK_SECRET=...

# --- Z-API (Fase 4) ---
ZAPI_INSTANCE_ID=...
ZAPI_INSTANCE_TOKEN=...
ZAPI_CLIENT_TOKEN=...
# Segredo não-enumerável embutido no path do webhook (Z-API não assina payloads):
ZAPI_WEBHOOK_SECRET=troque-por-um-uuid-aleatorio

# --- Inngest (executor de filas; em dev use `npx inngest-cli dev`, sem chaves) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- E-mail transacional (Resend) ---
# As DUAS são obrigatórias: com ADAPTER_MODE=real e qualquer uma faltando,
# isEmailConfigured() devolve false e nenhum e-mail sai (confirmação de pedido,
# pagamento aprovado, envio) — e a recuperação de senha self-service fica
# indisponível, avisando na tela. Passo a passo em docs/setup-externo.md.
RESEND_API_KEY=re_...
EMAIL_FROM="TRIVË <pedidos@seudominio.com.br>"

# --- Observabilidade ---
SENTRY_DSN=

# --- Operação ---
# fake = adapters simulados (dev/testes rodam o fluxo completo sem tocar MP/Z-API); real = produção
ADAPTER_MODE=fake
# Protege rotas internas de job/cron contra chamada externa:
JOBS_ROUTE_SECRET=troque-por-um-uuid-aleatorio
